{
  "name": "@polyhymnia/rhythm",
  "version": "0.3.0",
  "type": "module",
  "description": "Framework-independent rhythm plans, tap matching and browser attempt capture.",
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "default": "./dist/browser/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.browser.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrian729/rhythm.git",
    "directory": "packages/rhythm"
  },
  "homepage": "https://github.com/adrian729/rhythm/tree/main/packages/rhythm#readme",
  "bugs": {
    "url": "https://github.com/adrian729/rhythm/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
