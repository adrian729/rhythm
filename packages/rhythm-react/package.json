{
  "name": "@polyhymnia/rhythm-react",
  "version": "0.2.0",
  "type": "module",
  "description": "React adapters and configurable visuals for rhythm practice.",
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@polyhymnia/rhythm": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18 <20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrian729/rhythm.git",
    "directory": "packages/rhythm-react"
  },
  "homepage": "https://github.com/adrian729/rhythm/tree/main/packages/rhythm-react#readme",
  "bugs": {
    "url": "https://github.com/adrian729/rhythm/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
